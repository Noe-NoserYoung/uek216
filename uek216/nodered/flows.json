    {
        "id": "lb00000000fnst01",
        "type": "function",
        "z": "lb0000000000tab1",
        "name": "Status / Leerung",
        "func": "// Topic: lindenpark/letterbox/<firma>\nconst firma = msg.topic.split('/')[2];\nconst p = msg.payload;\n\nif (typeof p !== 'object' || typeof p.mail !== 'boolean') {\n    node.warn('Ungültige Nachricht: ' + JSON.stringify(p));\n    return null;\n}\n\nconst key = 'box_' + firma;\nconst prev = flow.get(key) || {};\nconst now = Date.now();\n\nconst state = {\n    mail: p.mail,\n    distance: p.distance,\n    lastSeen: now,\n    mailSince: prev.mailSince || null,\n    lastEmptied: prev.lastEmptied || null\n};\n\n// Post neu eingeworfen\nif (p.mail && !prev.mail) state.mailSince = now;\n\n// Wechsel Post -> leer = Briefkasten wurde geleert\nif (!p.mail && prev.mail) {\n    state.lastEmptied = now;\n    state.mailSince = null;\n}\n\nflow.set(key, state);\n\nconst t = new Date(now).toLocaleTimeString('de-CH');\nnode.status({\n    fill: p.mail ? 'yellow' : 'green',\n    shape: 'dot',\n    text: (p.mail ? 'Post vorhanden' : 'Leer') + ' · ' + t\n});\n\nmsg.payload = Object.assign({ firma: firma }, state);\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 100,
        "wires": [
            [
                "lb00000000dbg001",
                "766c33c1f98cf115"
            ]
        ]
    },
