    {
        "id": "lb00000000fndc01",
        "type": "function",
        "z": "lb0000000000tab1",
        "name": "Daily check",
        "func": "// Prüft alle bekannten Briefkästen\nconst keys = flow.keys().filter(k => k.startsWith('box_'));\nif (keys.length === 0) {\n    node.warn('Noch keine Daten von einem Briefkasten');\n    return null;\n}\n\nconst startOfDay = new Date();\nstartOfDay.setHours(0, 0, 0, 0);\n\nconst out = [];\nlet alarms = 0;\n\nfor (const k of keys) {\n    const s = flow.get(k);\n    const firma = k.slice(4);\n    const emptiedToday = s.lastEmptied && s.lastEmptied >= startOfDay.getTime();\n    const alarm = s.mail === true && !emptiedToday;\n    if (alarm) alarms++;\n\n    out.push({\n        topic: 'lindenpark/letterbox/' + firma + '/alarm',\n        payload: {\n            alarm: alarm,\n            firma: firma,\n            mail: s.mail,\n            mailSince: s.mailSince,\n            lastEmptied: s.lastEmptied,\n            text: alarm ? 'Briefkasten ' + firma + ' wurde heute nicht geleert!' : 'OK'\n        }\n    });\n}\n\nnode.status({\n    fill: alarms ? 'red' : 'green', shape: 'dot',\n    text: alarms ? alarms + ' Alarm(e)' : 'alles OK'\n});\n\nreturn [out];\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 360,
        "wires": [
            [
                "lb00000000sw0001"
            ]
        ]
    },
