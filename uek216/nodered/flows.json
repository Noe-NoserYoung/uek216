    {
        "id": "766c33c1f98cf115",
        "type": "function",
        "z": "lb0000000000tab1",
        "name": "Für Dashboard",
        "func": "const s = msg.payload;\nconst fmt = t => t ? new Date(t).toLocaleString('de-CH') : '–';\n\nreturn [\n    { payload: s.mail ? 'Post vorhanden' : 'Leer' },   // 1: Status\n    { payload: fmt(s.lastEmptied) },                    // 2: letzte Leerung\n    { payload: s.distance < 0 ? 0 : s.distance },       // 3: Distanz\n    { payload: s.mailSince ? fmt(s.mailSince) : '–' }   // 4: Post seit\n];\n",
        "outputs": 4,
